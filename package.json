{
  "name": "codeforge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "npm run db:generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "db:migrate": "prisma migrate dev --name init_phase2_schema",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "worker": "tsx src/worker/worker.ts",
    "ops:check-heartbeats": "tsx src/scripts/checkHeartbeats.ts",
    "ops:validate-heartbeat-expiry": "tsx src/scripts/validateHeartbeatExpiry.ts",
    "ops:validate-worker-shutdown": "tsx src/scripts/validateWorkerShutdown.ts",
    "ops:smoke-sandbox": "tsx src/scripts/smokeSandbox.ts",
    "ops:audit-cleanup": "tsx src/scripts/auditCleanup.ts",
    "ops:abuse-infinite-loop": "tsx src/scripts/abuseInfiniteLoop.ts",
    "ops:abuse-stdout-spam": "tsx src/scripts/abuseStdoutSpam.ts",
    "ops:abuse-memory-pressure": "tsx src/scripts/abuseMemoryPressure.ts",
    "ops:recovery-redis-restart": "tsx src/scripts/recoveryRedisRestart.ts",
    "ops:recovery-kill-worker": "tsx src/scripts/recoveryKillWorkerMidJob.ts",
    "ops:recovery-kill-worker-submission": "tsx src/scripts/recoveryKillWorkerMidSubmission.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.73.3",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "next": "16.2.2",
    "pg": "^8.20.0",
    "prisma": "^7.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^16.5.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
